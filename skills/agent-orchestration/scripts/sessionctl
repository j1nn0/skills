#!/usr/bin/env python3
"""Read and update deterministic per-session agent role configuration."""

import json
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

USAGE = """usage:
  sessionctl inspect
  sessionctl set-role --role {explorer|fixer} --harness H --model M --effort E"""

ROLES = ("explorer", "fixer")
ROLE_FIELDS = ("harness", "model", "effort")
CKSUM_POLY = 0x04C11DB7


def nonempty_string(value):
    return isinstance(value, str) and bool(value.strip())


def reject_json_constant(_value):
    raise ValueError("non-standard JSON constant")


def emit_json(value):
    print(json.dumps(value, separators=(",", ":")))


def usage_error():
    print(USAGE, file=sys.stderr)
    return 2


def parse_options(args, allowed):
    values = {}
    index = 0
    while index < len(args):
        option = args[index]
        if option not in allowed or option in values or index + 1 >= len(args):
            return None
        values[option] = args[index + 1]
        index += 2
    if set(values) != set(allowed):
        return None
    return values


def parse_args(argv):
    args = argv[1:]
    if args == ["inspect"]:
        return "inspect", {}
    if args and args[0] == "set-role":
        values = parse_options(args[1:], {"--role", "--harness", "--model", "--effort"})
        if values is None or values["--role"] not in ROLES:
            return None
        return "set-role", {
            "role": values["--role"],
            "harness": values["--harness"],
            "model": values["--model"],
            "effort": values["--effort"],
        }
    return None


def state_directory():
    xdg_state_home = os.environ.get("XDG_STATE_HOME")
    if xdg_state_home:
        base = Path(xdg_state_home)
    else:
        base = Path(os.environ.get("HOME") or str(Path.home())) / ".local" / "state"
    return base / "agent-orchestration"


def crc_step(crc, byte):
    crc ^= byte << 24
    for _ in range(8):
        if crc & 0x80000000:
            crc = ((crc << 1) ^ CKSUM_POLY) & 0xFFFFFFFF
        else:
            crc = (crc << 1) & 0xFFFFFFFF
    return crc


def posix_cksum(data):
    """Return POSIX cksum's CRC, including its length-suffix processing."""
    crc = 0
    for byte in data:
        crc = crc_step(crc, byte)
    length = len(data)
    while length:
        crc = crc_step(crc, length & 0xFF)
        length >>= 8
    return crc ^ 0xFFFFFFFF


def session_file(identity):
    identity_bytes = (
        identity["source"] + "\n" + identity["kind"] + "\n" + identity["value"] + "\n"
    ).encode("utf-8")
    key = "{}-{}".format(posix_cksum(identity_bytes), len(identity_bytes))
    return state_directory() / ("session-" + key + ".json")


def resolve_session():
    pane_id = os.environ.get("HERDR_PANE_ID")
    if pane_id is None or pane_id == "":
        return None
    herdr = shutil.which("herdr")
    if herdr is None:
        return None
    try:
        completed = subprocess.run(
            [herdr, "pane", "get", pane_id],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            check=False,
            timeout=10,
        )
    except (OSError, subprocess.SubprocessError, UnicodeError):
        return None
    if completed.returncode != 0:
        return None
    try:
        response = json.loads(completed.stdout, parse_constant=reject_json_constant)
        session = response["result"]["pane"]["agent_session"]
    except (ValueError, TypeError, KeyError):
        return None
    if not isinstance(session, dict):
        return None
    identity = {key: session.get(key) for key in ("source", "kind", "value")}
    if not all(nonempty_string(identity[key]) for key in identity):
        return None
    # The nested agent key and the rest of Herdr's response are intentionally ignored.
    return identity


def empty_role():
    return {field: "" for field in ROLE_FIELDS}


def normalize_role(value):
    if not isinstance(value, dict):
        return empty_role()
    return {
        field: value.get(field) if isinstance(value.get(field), str) else ""
        for field in ROLE_FIELDS
    }


def empty_read(state_available=False, readable=True, schema_version=None, reason=None):
    return {
        "state_available": state_available,
        "readable": readable,
        "schema_version": schema_version,
        "identity_matched": False,
        "explorer": None,
        "fixer": None,
        "reason": reason,
    }


def read_state(path, identity):
    try:
        raw = path.read_text(encoding="utf-8")
    except FileNotFoundError:
        return empty_read()
    except (OSError, UnicodeError):
        return empty_read(state_available=True, readable=False, reason="unreadable_state")
    try:
        document = json.loads(raw, parse_constant=reject_json_constant)
    except (ValueError, TypeError):
        return empty_read(state_available=True, readable=False, reason="unreadable_state")
    if not isinstance(document, dict):
        return empty_read(state_available=True, readable=False, reason="unreadable_state")

    version = document.get("schema_version", 1)
    if type(version) is not int or version not in (1, 2):
        return empty_read(state_available=True, readable=False, reason="unreadable_state")

    stored_identity = document.get("orchestrator_session")
    identity_matched = (
        isinstance(stored_identity, dict)
        and all(nonempty_string(stored_identity.get(key)) for key in ("source", "kind", "value"))
        and all(stored_identity.get(key) == identity[key] for key in ("source", "kind", "value"))
    )
    explorer = normalize_role(document.get("explorer"))
    fixer = normalize_role(document.get("fixer"))

    return {
        "state_available": True,
        "readable": True,
        "schema_version": version,
        "identity_matched": identity_matched,
        "explorer": explorer,
        "fixer": fixer,
        "reason": None,
    }


def refusal_reason(state):
    reason = state["reason"]
    if reason is None and state["state_available"] and not state["identity_matched"]:
        reason = "identity_mismatch"
    return reason


def configuration_complete(state):
    if not state["identity_matched"] or state["explorer"] is None or state["fixer"] is None:
        return False
    return all(
        nonempty_string(state[role][field])
        for role in ROLES
        for field in ROLE_FIELDS
    )


def envelope(action, identity, path, state, ok=True, reason=None, changed=False):
    if identity is None:
        state_file = None
        state_available = False
        schema_version = None
        identity_matched = False
        orchestrator_session = None
        explorer = None
        fixer = None
        complete = False
    else:
        state_file = str(path)
        state_available = state["state_available"]
        schema_version = state["schema_version"]
        identity_matched = state["identity_matched"]
        orchestrator_session = identity
        explorer = state["explorer"]
        fixer = state["fixer"]
        complete = configuration_complete(state)
    return {
        "ok": ok,
        "action": action,
        "reason": reason,
        "state_file": state_file,
        "schema_version": schema_version,
        "session_available": identity is not None,
        "state_available": state_available,
        "identity_matched": identity_matched,
        "configuration_complete": complete,
        "orchestrator_session": orchestrator_session,
        "explorer": explorer,
        "fixer": fixer,
        "changed": changed,
    }


def report(action, identity, path, state, ok=True, reason=None, changed=False):
    result = envelope(action, identity, path, state, ok=ok, reason=reason, changed=changed)
    emit_json(result)
    if not ok and reason:
        print("sessionctl: " + reason, file=sys.stderr)
    return 0


def default_mutable_state(identity, read):
    if read["state_available"] and read["readable"]:
        explorer = read["explorer"] or empty_role()
        fixer = read["fixer"] or empty_role()
    else:
        explorer = empty_role()
        fixer = empty_role()
    return {
        "schema_version": 2,
        "orchestrator_session": {
            "source": identity["source"],
            "kind": identity["kind"],
            "value": identity["value"],
        },
        "explorer": dict(explorer),
        "fixer": dict(fixer),
    }


def mutable_view(document):
    return {
        "state_available": True,
        "readable": True,
        "schema_version": 2,
        "identity_matched": True,
        "explorer": document["explorer"],
        "fixer": document["fixer"],
        "reason": None,
    }


def write_state(path, document):
    serialized = json.dumps(document, indent=2) + "\n"
    directory = path.parent
    directory.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(directory, 0o700)
    fd, temp_name = tempfile.mkstemp(prefix=".sessionctl-", suffix=".tmp", dir=str(directory))
    try:
        with os.fdopen(fd, "w", encoding="utf-8", newline="\n") as temp_file:
            temp_file.write(serialized)
        os.chmod(temp_name, 0o600)
        # No lock is used: a same-directory atomic replace prevents partial files;
        # concurrent writers are last-replace-wins by design.
        os.replace(temp_name, path)
    finally:
        try:
            os.unlink(temp_name)
        except FileNotFoundError:
            pass


def fail(action, identity, path, state, reason):
    return report(action, identity, path, state, ok=False, reason=reason)


def run_action(action, values):
    identity = resolve_session()
    if identity is None:
        return report(action, None, None, empty_read(), ok=False, reason="no_session")

    path = session_file(identity)
    state = read_state(path, identity)

    if action == "inspect":
        reason = refusal_reason(state)
        return report(action, identity, path, state, ok=reason is None, reason=reason)

    reason = refusal_reason(state)
    if reason is not None:
        return fail(action, identity, path, state, reason)

    if action == "set-role":
        if not all(nonempty_string(values[field]) for field in ROLE_FIELDS):
            return fail(action, identity, path, state, "invalid_role_value")
        document = default_mutable_state(identity, state)
        document[values["role"]] = {
            field: values[field].strip() for field in ROLE_FIELDS
        }
        try:
            write_state(path, document)
        except (OSError, UnicodeError, ValueError):
            return fail(action, identity, path, state, "write_failed")
        return report(action, identity, path, mutable_view(document), changed=True)

    return usage_error()


def main(argv):
    parsed = parse_args(argv)
    if parsed is None:
        return usage_error()
    action, values = parsed
    return run_action(action, values)


if __name__ == "__main__":
    sys.exit(main(sys.argv))
