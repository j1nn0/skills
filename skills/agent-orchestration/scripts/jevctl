#!/usr/bin/env python3
"""Optional Jev gates for the agent-orchestration skill."""

import json
import math
import os
import shutil
import subprocess
import sys
from pathlib import Path


DEFAULT_MODEL = "typesafe/jev"
DEFAULT_TRANSPORT = "cmd"
DEFAULT_MODE = "active"
DEFAULT_TIMEOUT = 60.0
DEFAULT_MAX_STATE_CHARS = 12000
DEFAULT_THRESHOLDS = {
    "outcome_min": 0.90,
    "unresolved_max": 0.10,
    "scope_max": 0.15,
    "action_conf_min": 0.80,
}
CONFIG_KEYS = {"model", "transport", "timeout", "thresholds", "enabled", "mode", "gates"}
THRESHOLD_ENV = {
    "outcome_min": "JEVCTL_OUTCOME_MIN",
    "unresolved_max": "JEVCTL_UNRESOLVED_MAX",
    "scope_max": "JEVCTL_SCOPE_MAX",
    "action_conf_min": "JEVCTL_ACTION_CONF_MIN",
}
ALLOWED_ACTIONS = (
    "complete",
    "retry_fix",
    "reinvestigate",
    "orchestrator_review",
)
ANSWER_IDS = ("outcome_supported", "unresolved_issue", "scope_exceeded")
EXPLORER_ALLOWED_ACTIONS = ("proceed_to_fix", "explore_more", "orchestrator_review")
EXPLORER_ANSWER_IDS = ("evidence_grounded", "claim_supported", "material_gap")
EXPLORER_DEFAULT_THRESHOLDS = {
    "grounded_min": 0.75,
    "supported_min": 0.75,
    "material_gap_max": 0.20,
    "action_conf_min": 0.75,
}
GATE_CONFIG_KEYS = {"enabled", "mode", "thresholds"}
EXPLORER_FORBIDDEN_KEYS = {
    "transcript",
    "raw_transcript",
    "agent_transcript",
    "source_files",
    "full_source",
    "repository_dump",
    "orchestrator_decision",
    "intended_action",
    "tentative_action",
    "retry_count",
    "retry_counter",
    "loop_count",
    "loop_counter",
    "round_count",
    "attempt_count",
    "harness",
    "model",
    "effort",
    "prompt",
    "prompts",
}
TRUNCATION_MARKER = "[state truncated]"
EXIT_CODE_REASONS = {
    3: "auth_error",
    4: "permission_denied",
    5: "rate_limited",
    6: "connection_error",
    7: "server_error",
    8: "max_turns_exceeded",
    9: "no_response",
    10: "insufficient_credits",
    130: "interrupted",
}
USAGE = "usage: jevctl {doctor|completion-gate|explorer-gate}"


class JevctlError(Exception):
    def __init__(self, reason):
        super().__init__(reason)
        self.reason = reason


def reject_json_constant(_value):
    raise ValueError("non-standard JSON constant")


def parse_json(text):
    return json.loads(text, parse_constant=reject_json_constant)


def is_valid_json_value(value):
    if value is None or isinstance(value, (str, bool, int)):
        return True
    if isinstance(value, float):
        return math.isfinite(value)
    if isinstance(value, list):
        return all(is_valid_json_value(item) for item in value)
    if isinstance(value, dict):
        return all(
            isinstance(key, str) and is_valid_json_value(item)
            for key, item in value.items()
        )
    return False


def config_file_path():
    config_home = os.environ.get("XDG_CONFIG_HOME")
    if config_home:
        base = Path(config_home)
    else:
        base = Path(os.environ.get("HOME") or str(Path.home())) / ".config"
    return base / "agent-orchestration" / "jev.json"


def parse_probability(value, allow_string=False):
    if allow_string and isinstance(value, str):
        try:
            value = float(value)
        except ValueError:
            raise JevctlError("invalid_config") from None
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        raise JevctlError("invalid_config")
    try:
        result = float(value)
    except OverflowError:
        raise JevctlError("invalid_config") from None
    if not math.isfinite(result) or result < 0.0 or result > 1.0:
        raise JevctlError("invalid_config")
    return result


def parse_positive_number(value):
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        raise JevctlError("invalid_config")
    try:
        result = float(value)
    except OverflowError:
        raise JevctlError("invalid_config") from None
    if not math.isfinite(result) or result <= 0.0:
        raise JevctlError("invalid_config")
    return result


def parse_enabled(value):
    if isinstance(value, bool):
        return value
    if isinstance(value, str):
        normalized = value.strip().lower()
        if normalized in ("1", "true", "yes", "on"):
            return True
        if normalized in ("0", "false", "no", "off"):
            return False
    raise JevctlError("invalid_config")


def parse_mode(value):
    if isinstance(value, str):
        normalized = value.strip().lower()
        if normalized in ("shadow", "active"):
            return normalized
    raise JevctlError("invalid_config")


def load_settings():
    config = {}
    path = config_file_path()
    try:
        if path.is_file():
            loaded = parse_json(path.read_text(encoding="utf-8"))
            if not isinstance(loaded, dict) or not set(loaded).issubset(CONFIG_KEYS):
                raise JevctlError("invalid_config")
            config = loaded
    except JevctlError:
        raise
    except (OSError, UnicodeError, ValueError, RecursionError):
        raise JevctlError("invalid_config") from None

    configured_gates = config.get("gates", {})
    if not isinstance(configured_gates, dict) or not set(configured_gates).issubset(
        {"completion", "explorer"}
    ):
        raise JevctlError("invalid_config")
    gate_configs = {}
    for gate_name in ("completion", "explorer"):
        gate_config = configured_gates.get(gate_name, {})
        if not isinstance(gate_config, dict) or not set(gate_config).issubset(
            GATE_CONFIG_KEYS
        ):
            raise JevctlError("invalid_config")
        gate_configs[gate_name] = gate_config

    settings = {
        "model": config.get("model", DEFAULT_MODEL),
        "transport": config.get("transport", DEFAULT_TRANSPORT),
        "timeout": config.get("timeout", DEFAULT_TIMEOUT),
        "thresholds": dict(DEFAULT_THRESHOLDS),
        "enabled": False,
        "mode": config.get("mode", DEFAULT_MODE),
    }
    configured_thresholds = config.get("thresholds", {})
    if not isinstance(configured_thresholds, dict) or not set(configured_thresholds).issubset(
        DEFAULT_THRESHOLDS
    ):
        raise JevctlError("invalid_config")
    for key in DEFAULT_THRESHOLDS:
        if key in configured_thresholds:
            settings["thresholds"][key] = parse_probability(configured_thresholds[key])

    # Gate-specific completion thresholds override the shared legacy thresholds.
    configured_completion_thresholds = gate_configs["completion"].get("thresholds", {})
    if not isinstance(configured_completion_thresholds, dict) or not set(
        configured_completion_thresholds
    ).issubset(DEFAULT_THRESHOLDS):
        raise JevctlError("invalid_config")
    for key, value in configured_completion_thresholds.items():
        settings["thresholds"][key] = parse_probability(value)

    explorer_thresholds = dict(EXPLORER_DEFAULT_THRESHOLDS)
    configured_explorer_thresholds = gate_configs["explorer"].get("thresholds", {})
    if not isinstance(configured_explorer_thresholds, dict) or not set(
        configured_explorer_thresholds
    ).issubset(EXPLORER_DEFAULT_THRESHOLDS):
        raise JevctlError("invalid_config")
    for key, value in configured_explorer_thresholds.items():
        explorer_thresholds[key] = parse_probability(value)

    env_settings = {
        "model": "JEVCTL_MODEL",
        "transport": "JEVCTL_TRANSPORT",
        "mode": "JEVCTL_MODE",
    }
    for setting, env_name in env_settings.items():
        if env_name in os.environ:
            settings[setting] = os.environ[env_name]
    for key, env_name in THRESHOLD_ENV.items():
        if env_name in os.environ:
            settings["thresholds"][key] = parse_probability(os.environ[env_name], allow_string=True)
    if "JEVCTL_ENABLED" in os.environ:
        settings["enabled"] = parse_enabled(os.environ["JEVCTL_ENABLED"])
    elif "enabled" in config:
        settings["enabled"] = parse_enabled(config["enabled"])
    settings["mode"] = parse_mode(settings["mode"])
    global_enabled = settings["enabled"]
    global_mode = settings["mode"]

    completion_gate_config = gate_configs["completion"]
    if "enabled" in completion_gate_config:
        completion_gate_enabled = parse_enabled(completion_gate_config["enabled"])
    else:
        completion_gate_enabled = True
    completion_enabled = global_enabled and completion_gate_enabled
    completion_mode = parse_mode(completion_gate_config.get("mode", global_mode))

    explorer_gate_config = gate_configs["explorer"]
    if "JEVCTL_EXPLORER_ENABLED" in os.environ:
        explorer_gate_enabled = parse_enabled(os.environ["JEVCTL_EXPLORER_ENABLED"])
    else:
        explorer_gate_enabled = parse_enabled(explorer_gate_config.get("enabled", False))
    explorer_enabled = global_enabled and explorer_gate_enabled
    if "JEVCTL_EXPLORER_MODE" in os.environ:
        explorer_mode_value = os.environ["JEVCTL_EXPLORER_MODE"]
    else:
        explorer_mode_value = explorer_gate_config.get("mode", "shadow")
    explorer_mode = parse_mode(explorer_mode_value)

    if not isinstance(settings["model"], str) or not settings["model"].strip():
        raise JevctlError("invalid_config")
    settings["model"] = settings["model"].strip()
    if settings["transport"] not in ("cmd", "provider"):
        raise JevctlError("invalid_config")
    if "JEVCTL_TIMEOUT" in os.environ:
        try:
            settings["timeout"] = float(os.environ["JEVCTL_TIMEOUT"])
        except ValueError:
            raise JevctlError("invalid_config") from None
    settings["timeout"] = parse_positive_number(settings["timeout"])
    if "JEVCTL_MAX_STATE_CHARS" in os.environ:
        try:
            state_cap = int(os.environ["JEVCTL_MAX_STATE_CHARS"])
        except ValueError:
            raise JevctlError("invalid_config") from None
        if state_cap <= 0:
            raise JevctlError("invalid_config")
    else:
        state_cap = DEFAULT_MAX_STATE_CHARS
    settings["max_state_chars"] = state_cap
    settings["enabled"] = completion_enabled
    settings["mode"] = completion_mode
    settings["gates"] = {
        "completion": {"enabled": completion_enabled, "mode": completion_mode},
        "explorer": {
            "enabled": explorer_enabled,
            "mode": explorer_mode,
            "thresholds": explorer_thresholds,
        },
    }
    return settings


def safe_child_environment():
    """Pass runtime essentials only; do not forward ambient credential variables."""
    allowed = ("PATH", "HOME", "XDG_CONFIG_HOME", "TMPDIR", "LANG", "LC_ALL", "CMD_ZDR")
    return {name: os.environ[name] for name in allowed if name in os.environ}


def reason_for_exit(returncode):
    return EXIT_CODE_REASONS.get(returncode, "transport_error")


def run_cmd_smoke(timeout):
    command_path = shutil.which("cmd")
    if command_path is None:
        raise JevctlError("missing_command")
    try:
        result = subprocess.run(
            [command_path, "--version"],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=timeout,
            env=safe_child_environment(),
            check=False,
        )
    except subprocess.TimeoutExpired:
        raise JevctlError("timeout") from None
    except OSError:
        raise JevctlError("transport_error") from None
    if result.returncode != 0:
        raise JevctlError(reason_for_exit(result.returncode))
    return command_path


def doctor_gates(settings):
    return {
        gate_name: {
            "enabled": gate_settings["enabled"],
            "mode": gate_settings["mode"],
        }
        for gate_name, gate_settings in settings["gates"].items()
    }


def doctor_result():
    try:
        settings = load_settings()
    except JevctlError as error:
        return {
            "ok": False,
            "model": DEFAULT_MODEL,
            "transport": DEFAULT_TRANSPORT,
            "enabled": False,
            "mode": DEFAULT_MODE,
            "reason": error.reason,
        }
    if not settings["enabled"]:
        return {
            "ok": False,
            "model": settings["model"],
            "transport": settings["transport"],
            "enabled": False,
            "mode": settings["mode"],
            "gates": doctor_gates(settings),
            "reason": "disabled",
        }
    if settings["transport"] == "provider":
        return {
            "ok": False,
            "model": settings["model"],
            "transport": settings["transport"],
            "enabled": True,
            "mode": settings["mode"],
            "gates": doctor_gates(settings),
            "reason": "provider_not_implemented",
        }
    try:
        command_path = run_cmd_smoke(settings["timeout"])
    except JevctlError as error:
        return {
            "ok": False,
            "model": settings["model"],
            "transport": settings["transport"],
            "enabled": True,
            "mode": settings["mode"],
            "gates": doctor_gates(settings),
            "reason": error.reason,
        }
    return {
        "ok": True,
        "model": settings["model"],
        "transport": settings["transport"],
        "enabled": True,
        "mode": settings["mode"],
        "gates": doctor_gates(settings),
        "cmd_path": command_path,
    }


def validate_gate_input(data):
    if not isinstance(data, dict):
        raise JevctlError("invalid_request")
    required = {
        "task_summary",
        "root_cause_summary",
        "implementation_summary",
        "changed_files",
        "diff_stats",
        "verification",
        "tests_summary",
        "remaining_issues",
        "review_findings",
        "deterministic_pass",
    }
    if not required.issubset(data):
        raise JevctlError("invalid_request")
    for key in (
        "task_summary",
        "root_cause_summary",
        "implementation_summary",
        "tests_summary",
    ):
        if not isinstance(data[key], str):
            raise JevctlError("invalid_request")
    if not isinstance(data["changed_files"], list) or not all(
        isinstance(item, str) for item in data["changed_files"]
    ):
        raise JevctlError("invalid_request")
    if not isinstance(data["remaining_issues"], list) or not all(
        isinstance(item, str) for item in data["remaining_issues"]
    ):
        raise JevctlError("invalid_request")
    if not isinstance(data["deterministic_pass"], bool):
        raise JevctlError("invalid_request")

    verification = data["verification"]
    if not isinstance(verification, dict):
        raise JevctlError("invalid_request")
    if not isinstance(verification.get("commands"), list) or not all(
        isinstance(item, str) for item in verification["commands"]
    ):
        raise JevctlError("invalid_request")
    has_exit_status = "exit_status" in verification
    has_results = "per_command_results" in verification or "results" in verification
    if not (has_exit_status or has_results):
        raise JevctlError("invalid_request")
    if has_exit_status and (
        isinstance(verification["exit_status"], bool)
        or not isinstance(verification["exit_status"], int)
    ):
        raise JevctlError("invalid_request")
    for key in ("per_command_results", "results"):
        if key in verification and not isinstance(verification[key], (list, dict)):
            raise JevctlError("invalid_request")

    # Restrict state to the settled report fields; do not forward extra caller data.
    summary = {
        "task_summary": data["task_summary"],
        "root_cause_summary": data["root_cause_summary"],
        "implementation_summary": data["implementation_summary"],
        "changed_files": data["changed_files"],
        "diff_stats": data["diff_stats"],
        "verification": verification,
        "tests_summary": data["tests_summary"],
        "remaining_issues": data["remaining_issues"],
        "review_findings": data["review_findings"],
        "deterministic_pass": data["deterministic_pass"],
    }
    if not is_valid_json_value(summary):
        raise JevctlError("invalid_request")
    return summary



def nonempty_string(value):
    return isinstance(value, str) and bool(value.strip())


def validate_evidence_items(value, allow_empty):
    if not isinstance(value, list) or (not allow_empty and not value):
        raise JevctlError("invalid_request")
    items = []
    for item in value:
        if (
            not isinstance(item, dict)
            or not {"source", "observation"}.issubset(item)
            or not nonempty_string(item["source"])
            or not nonempty_string(item["observation"])
        ):
            raise JevctlError("invalid_request")
        items.append({"source": item["source"], "observation": item["observation"]})
    return items


def validate_explorer_input(data):
    if not isinstance(data, dict) or EXPLORER_FORBIDDEN_KEYS.intersection(data):
        raise JevctlError("invalid_request")
    required = {
        "task_summary",
        "investigation_goal",
        "explorer_claim",
        "evidence_supporting_claim",
        "contradictory_evidence",
        "remaining_unknowns",
    }
    if not required.issubset(data):
        raise JevctlError("invalid_request")
    for key in ("task_summary", "investigation_goal", "explorer_claim"):
        if not nonempty_string(data[key]):
            raise JevctlError("invalid_request")

    supporting = validate_evidence_items(data["evidence_supporting_claim"], allow_empty=False)
    contradictory = validate_evidence_items(data["contradictory_evidence"], allow_empty=True)
    unknowns = data["remaining_unknowns"]
    if not isinstance(unknowns, list) or not all(nonempty_string(item) for item in unknowns):
        raise JevctlError("invalid_request")
    if "orchestrator_reviewed" in data and not isinstance(data["orchestrator_reviewed"], bool):
        raise JevctlError("invalid_request")

    summary = {
        "task_summary": data["task_summary"],
        "investigation_goal": data["investigation_goal"],
        "explorer_claim": data["explorer_claim"],
        "evidence_supporting_claim": supporting,
        "contradictory_evidence": contradictory,
        "remaining_unknowns": unknowns,
    }
    if "orchestrator_reviewed" in data:
        summary["orchestrator_reviewed"] = data["orchestrator_reviewed"]
    for key in ("files_examined", "tests_examined", "external_sources"):
        if key in data:
            values = data[key]
            if not isinstance(values, list) or not all(nonempty_string(item) for item in values):
                raise JevctlError("invalid_request")
            summary[key] = values
    if "explorer_confidence" in data:
        confidence = data["explorer_confidence"]
        if (
            not isinstance(confidence, dict)
            or set(confidence) != {"level", "reason"}
            or not isinstance(confidence["level"], str)
            or confidence["level"] not in {"high", "medium", "low"}
            or not nonempty_string(confidence["reason"])
        ):
            raise JevctlError("invalid_request")
        summary["explorer_confidence"] = {
            "level": confidence["level"],
            "reason": confidence["reason"],
        }
    if not is_valid_json_value(summary):
        raise JevctlError("invalid_request")
    return summary


def make_state(summary, char_cap):
    compact = json.dumps(
        summary,
        ensure_ascii=False,
        separators=(",", ":"),
        sort_keys=True,
        allow_nan=False,
    )
    if len(compact) > char_cap:
        if char_cap >= len(TRUNCATION_MARKER):
            compact = compact[: char_cap - len(TRUNCATION_MARKER)] + TRUNCATION_MARKER
        else:
            compact = TRUNCATION_MARKER[:char_cap]
    return compact


def build_questions():
    return {
        "outcome_supported": {
            "type": "noul",
            "instructions": "Estimate the probability that the requested outcome is achieved, based only on the settled evidence.",
            "criteria": {
                "true": "The summarized implementation and verification support that the requested outcome is achieved.",
                "false": "The settled evidence does not adequately support that the requested outcome is achieved.",
            },
        },
        "unresolved_issue": {
            "type": "noul",
            "instructions": "Estimate the probability that a material issue remains unresolved.",
            "criteria": {
                "true": "A material defect, failed check, or unresolved blocker remains.",
                "false": "No material unresolved issue is indicated by the settled report.",
            },
        },
        "scope_exceeded": {
            "type": "noul",
            "instructions": "Estimate the probability that implementation exceeded the authorized scope.",
            "criteria": {
                "true": "The reported changes exceed the task's authorized scope.",
                "false": "The reported changes remain within the authorized scope.",
            },
        },
        "next_action": {
            "type": "choice",
            "instructions": "Choose the single appropriate next action based only on the settled state and these criteria.",
            "criteria": {
                "complete": "The intended outcome is supported, deterministic checks passed, and no material unresolved issue or scope violation remains.",
                "retry_fix": "A clear implementation defect needs a bounded correction from the fixer.",
                "reinvestigate": "A cause or assumption remains uncertain and needs further investigation.",
                "orchestrator_review": "The result needs the orchestrator's judgment; do not infer permission to complete.",
            },
        },
    }



def build_explorer_questions():
    evidence_instructions = (
        "Judge the evidence itself, not the explorer's confidence or assertive wording. "
        "Do not accept phrases such as 'root cause confirmed', 'definitely caused by', "
        "or 'fully verified' unless the cited observations support them."
    )
    return {
        "evidence_grounded": {
            "type": "noul",
            "instructions": (
                "Estimate the probability that the explorer's claim is grounded in the "
                "listed, traceable observations. " + evidence_instructions
            ),
            "criteria": {
                "true": "Supporting observations cite concrete sources and directly bear on the claim.",
                "false": "The claim rests mainly on inference, assertion, or evidence that cannot be traced to an observation.",
            },
        },
        "claim_supported": {
            "type": "noul",
            "instructions": (
                "Estimate the probability that the listed evidence supports the specific "
                "explorer_claim rather than merely being consistent with it. "
                + evidence_instructions
            ),
            "criteria": {
                "true": "The observations substantiate the claim and distinguish it from plausible alternatives.",
                "false": "The observations do not establish the claim, or plausible alternatives remain equally supported.",
            },
        },
        "material_gap": {
            "type": "noul",
            "instructions": (
                "Estimate the probability that contradictory evidence or a remaining "
                "unknown materially limits the claim or a safe next step. " + evidence_instructions
            ),
            "criteria": {
                "true": "A material contradiction or unresolved factual gap could change the conclusion or safe strategy.",
                "false": "No listed contradiction or unknown materially affects the supported conclusion or next step.",
            },
        },
        "next_step": {
            "type": "choice",
            "instructions": (
                "Choose the single appropriate next step from the settled evidence. "
                "This is a recommendation only: it does not authorize implementation or "
                "replace orchestrator judgment. " + evidence_instructions
            ),
            "criteria": {
                "proceed_to_fix": "The evidence supports a bounded strategy strongly enough for the orchestrator to consider a fixer handoff.",
                "explore_more": "A focused investigation could resolve a material contradiction, unknown, or unsupported claim.",
                "orchestrator_review": "Evidence is conflicting, untraceable, consequential, or requires the orchestrator's judgment.",
            },
        },
    }

def cmd_transport(request, model, timeout):
    command_path = shutil.which("cmd")
    if command_path is None:
        raise JevctlError("missing_command")
    prompt = json.dumps(request, ensure_ascii=False, separators=(",", ":"))
    try:
        result = subprocess.run(
            [command_path, "-p", prompt, "-m", model],
            input="",
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=timeout,
            env=safe_child_environment(),
            check=False,
        )
    except subprocess.TimeoutExpired:
        raise JevctlError("timeout") from None
    except OSError:
        raise JevctlError("transport_error") from None
    if result.returncode != 0:
        raise JevctlError(reason_for_exit(result.returncode))
    try:
        return parse_json(result.stdout)
    except (ValueError, TypeError, RecursionError):
        raise JevctlError("invalid_response") from None


def provider_transport(_request, _model, _timeout):
    # Future extension point. v1 intentionally has no provider API or key handling.
    raise JevctlError("provider_not_implemented")


def validate_choice_response(response, model, answer_ids, allowed_actions, choice_id):
    required_response_fields = {"model", "answers", "usage"}
    if not isinstance(response, dict) or not required_response_fields.issubset(response):
        raise JevctlError("invalid_response")

    returned_model = response["model"]
    if not isinstance(returned_model, str) or not returned_model.strip():
        raise JevctlError("invalid_response")
    is_jev_family = (
        returned_model == "jev-latest"
        or returned_model.startswith("jev-")
        or returned_model.startswith("typesafe/jev")
    )
    if returned_model != model and not is_jev_family:
        raise JevctlError("invalid_response")
    if not isinstance(response["usage"], dict) or not is_valid_json_value(response["usage"]):
        raise JevctlError("invalid_response")

    answers = response["answers"]
    required_answer_ids = set(answer_ids) | {choice_id}
    if not isinstance(answers, dict) or not required_answer_ids.issubset(answers):
        raise JevctlError("invalid_response")

    values = {}
    for answer_id in answer_ids:
        answer = answers[answer_id]
        if not isinstance(answer, dict) or not {"type", "noul"}.issubset(answer):
            raise JevctlError("invalid_response")
        if answer["type"] != "noul":
            raise JevctlError("invalid_response")
        try:
            values[answer_id] = parse_probability(answer["noul"])
        except JevctlError:
            raise JevctlError("invalid_response") from None

    action_answer = answers[choice_id]
    required_choice_fields = {"type", "choice", "confidence", "probabilities"}
    if not isinstance(action_answer, dict) or not required_choice_fields.issubset(action_answer):
        raise JevctlError("invalid_response")
    if action_answer["type"] != "choice":
        raise JevctlError("invalid_response")
    action = action_answer["choice"]
    if not isinstance(action, str) or action not in allowed_actions:
        raise JevctlError("invalid_response")
    try:
        confidence = parse_probability(action_answer["confidence"])
    except JevctlError:
        raise JevctlError("invalid_response") from None
    probabilities = action_answer["probabilities"]
    if not isinstance(probabilities, dict) or any(
        not isinstance(option, str) or option not in allowed_actions for option in probabilities
    ):
        raise JevctlError("invalid_response")
    try:
        for probability in probabilities.values():
            parse_probability(probability)
    except JevctlError:
        raise JevctlError("invalid_response") from None
    return values, action, confidence


def validate_response(response, model):
    return validate_choice_response(response, model, ANSWER_IDS, ALLOWED_ACTIONS, "next_action")


def gate_unavailable_result(gate, reason, mode, answer_ids, confidence_field):
    if gate == "completion":
        return {
            "schema_version": 1,
            "gate": "completion",
            "status": "unavailable",
            "action": "orchestrator_review",
            "auto_apply": False,
            "would_auto_apply": False,
            "mode": mode,
            confidence_field: 0.0,
            "answers": {answer_id: None for answer_id in answer_ids},
            "next_action": "orchestrator_review",
            "next_action_confidence": 0.0,
            "reason": reason,
        }
    return {
        "schema_version": 1,
        "gate": "explorer",
        "status": "unavailable",
        "action": "orchestrator_review",
        "auto_apply": False,
        "would_block": False,
        "evidence_sufficient": False,
        "mode": mode,
        "answers": {answer_id: None for answer_id in answer_ids},
        "next_step": "orchestrator_review",
        "next_step_confidence": 0.0,
        "reason": reason,
    }


def unavailable_result(reason, mode=DEFAULT_MODE):
    return gate_unavailable_result(
        "completion", reason, mode, ANSWER_IDS, "completion_confidence"
    )


def completion_result():
    mode = DEFAULT_MODE
    try:
        settings = load_settings()
        mode = settings["mode"]
        if not settings["enabled"]:
            return unavailable_result("disabled", mode)
        try:
            data = parse_json(sys.stdin.read())
        except (ValueError, TypeError, RecursionError):
            raise JevctlError("invalid_request") from None
        summary = validate_gate_input(data)
        if not data["deterministic_pass"]:
            return unavailable_result("deterministic_failure", mode)
        request = {
            "state": make_state(summary, settings["max_state_chars"]),
            "questions": build_questions(),
        }
        if settings["transport"] == "cmd":
            response = cmd_transport(request, settings["model"], settings["timeout"])
        else:
            response = provider_transport(request, settings["model"], settings["timeout"])
        values, action, confidence = validate_response(response, settings["model"])
    except JevctlError as error:
        return unavailable_result(error.reason, mode)
    except (OSError, UnicodeError, ValueError, TypeError, RecursionError):
        return unavailable_result("invalid_response", mode)
    except KeyboardInterrupt:
        return unavailable_result("interrupted", mode)

    thresholds = settings["thresholds"]
    completion_eligible = (
        values["outcome_supported"] >= thresholds["outcome_min"]
        and values["unresolved_issue"] <= thresholds["unresolved_max"]
        and values["scope_exceeded"] <= thresholds["scope_max"]
    )
    status = "decided" if confidence >= thresholds["action_conf_min"] else "uncertain"
    completion_confidence = min(
        values["outcome_supported"],
        1.0 - values["unresolved_issue"],
        1.0 - values["scope_exceeded"],
        confidence,
    )
    active_calc = bool(
        data["deterministic_pass"]
        and status == "decided"
        and action == "complete"
        and completion_eligible
    )
    auto_apply = active_calc if mode == "active" else False
    return {
        "schema_version": 1,
        "gate": "completion",
        "status": status,
        "action": action,
        "auto_apply": auto_apply,
        "would_auto_apply": active_calc,
        "mode": mode,
        "completion_confidence": completion_confidence,
        "answers": values,
        "next_action": action,
        "next_action_confidence": confidence,
    }



def explorer_result():
    mode = "shadow"
    try:
        settings = load_settings()
        explorer_settings = settings["gates"]["explorer"]
        mode = explorer_settings["mode"]
        if not explorer_settings["enabled"]:
            return gate_unavailable_result(
                "explorer", "disabled", mode, EXPLORER_ANSWER_IDS, None
            )
        try:
            data = parse_json(sys.stdin.read())
        except (ValueError, TypeError, RecursionError):
            raise JevctlError("invalid_request") from None
        summary = validate_explorer_input(data)
        if data.get("orchestrator_reviewed") is not True:
            return gate_unavailable_result(
                "explorer", "review_incomplete", mode, EXPLORER_ANSWER_IDS, None
            )
        request = {
            "state": make_state(summary, settings["max_state_chars"]),
            "questions": build_explorer_questions(),
        }
        if settings["transport"] == "cmd":
            response = cmd_transport(request, settings["model"], settings["timeout"])
        else:
            response = provider_transport(request, settings["model"], settings["timeout"])
        values, action, confidence = validate_choice_response(
            response, settings["model"], EXPLORER_ANSWER_IDS, EXPLORER_ALLOWED_ACTIONS, "next_step"
        )
    except JevctlError as error:
        return gate_unavailable_result(
            "explorer", error.reason, mode, EXPLORER_ANSWER_IDS, None
        )
    except (OSError, UnicodeError, ValueError, TypeError, RecursionError):
        return gate_unavailable_result(
            "explorer", "invalid_response", mode, EXPLORER_ANSWER_IDS, None
        )
    except KeyboardInterrupt:
        return gate_unavailable_result(
            "explorer", "interrupted", mode, EXPLORER_ANSWER_IDS, None
        )

    thresholds = explorer_settings["thresholds"]
    confident = confidence >= thresholds["action_conf_min"]
    status = "decided" if confident else "uncertain"
    evidence_sufficient = bool(
        action == "proceed_to_fix"
        and confident
        and values["evidence_grounded"] >= thresholds["grounded_min"]
        and values["claim_supported"] >= thresholds["supported_min"]
        and values["material_gap"] <= thresholds["material_gap_max"]
    )
    would_block = bool(status == "decided" and action == "explore_more" and confident)
    return {
        "schema_version": 1,
        "gate": "explorer",
        "status": status,
        "action": action,
        "auto_apply": False,
        "would_block": would_block,
        "evidence_sufficient": evidence_sufficient,
        "mode": mode,
        "answers": values,
        "next_step": action,
        "next_step_confidence": confidence,
    }


def emit_json(value):
    print(json.dumps(value, ensure_ascii=False, separators=(",", ":")))


def main(argv):
    if len(argv) != 2 or argv[1] not in ("doctor", "completion-gate", "explorer-gate"):
        print(USAGE, file=sys.stderr)
        return 2
    if argv[1] == "doctor":
        try:
            result = doctor_result()
        except KeyboardInterrupt:
            result = {
                "ok": False,
                "model": DEFAULT_MODEL,
                "transport": DEFAULT_TRANSPORT,
                "enabled": False,
                "mode": DEFAULT_MODE,
                "reason": "interrupted",
            }
        if not result["ok"]:
            print("jevctl: " + result["reason"], file=sys.stderr)
        emit_json(result)
        return 0
    if argv[1] == "completion-gate":
        try:
            result = completion_result()
        except KeyboardInterrupt:
            result = unavailable_result("interrupted")
    else:
        mode = "shadow"
        try:
            try:
                mode = load_settings()["gates"]["explorer"]["mode"]
            except JevctlError:
                pass
            result = explorer_result()
        except KeyboardInterrupt:
            result = gate_unavailable_result(
                "explorer", "interrupted", mode, EXPLORER_ANSWER_IDS, None
            )
    if result["status"] == "unavailable":
        print("jevctl: " + result["reason"], file=sys.stderr)
    emit_json(result)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
