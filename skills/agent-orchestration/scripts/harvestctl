#!/usr/bin/env python3
"""Discover Harvest capture support and explicitly claim a completed pane."""

# Exit 0 means a normalized verdict was emitted, exit 2 means CLI usage error,
# and other non-zero exits are reserved for impossible internal defects.

import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

USAGE = """usage:
  harvestctl doctor --role {explorer|fixer}
  harvestctl claim --pane PANE --id UUID --label LABEL --role {explorer|fixer}"""

PLUGIN_ID = "j1nn0.herdr-harvest"
CAPTURE_PROTOCOL = "harvest-capture"
LOCATOR_PROTOCOL = "harvest-runtime-locator"
LOCATOR_FILENAME = "orchestration-capture-runtime.json"
ROLES = ("explorer", "fixer")
UUID4_RE = re.compile(
    r"^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
)


def nonempty_string(value):
    return isinstance(value, str) and bool(value.strip())


def reject_json_constant(_value):
    raise ValueError("non-standard JSON constant")


def parse_json(text):
    return json.loads(text, parse_constant=reject_json_constant)


def single_line_content(text):
    if not isinstance(text, str):
        return None
    if text.endswith("\r\n"):
        text = text[:-2]
    elif text.endswith(("\r", "\n")):
        text = text[:-1]
    if "\r" in text or "\n" in text:
        return None
    return text


def parse_json_line(text):
    """Parse exactly one JSON line, rejecting non-standard numeric constants."""
    line = single_line_content(text)
    if line is None:
        raise ValueError("expected one JSON line")
    return parse_json(line)


def emit_json(value):
    print(json.dumps(value, separators=(",", ":")))


def usage_error():
    print(USAGE, file=sys.stderr)
    return 2


def parse_options(args, allowed):
    values = {}
    index = 0
    while index < len(args):
        option = args[index]
        if option not in allowed or option in values or index + 1 >= len(args):
            return None
        values[option] = args[index + 1]
        index += 2
    if set(values) != set(allowed):
        return None
    return values


def valid_label(value):
    if not isinstance(value, str) or not value.strip() or len(value) > 256:
        return False
    return not any(char in value for char in "\r\n\u0085\u2028\u2029")


def parse_args(argv):
    args = argv[1:]
    if len(args) < 1:
        return None
    if args[0] == "doctor":
        values = parse_options(args[1:], {"--role"})
        if values is None or values["--role"] not in ROLES:
            return None
        return "doctor", {"role": values["--role"]}
    if args[0] == "claim":
        values = parse_options(args[1:], {"--pane", "--id", "--label", "--role"})
        if values is None:
            return None
        if (
            not values["--pane"].strip()
            or UUID4_RE.fullmatch(values["--id"]) is None
            or not valid_label(values["--label"])
            or values["--role"] not in ROLES
        ):
            return None
        return "claim", {
            "pane": values["--pane"],
            "id": values["--id"],
            "label": values["--label"],
            "role": values["--role"],
        }
    return None


def run_command(argv, env=None):
    try:
        return subprocess.run(
            argv,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            check=False,
            timeout=10,
            env=env,
        )
    except (OSError, subprocess.SubprocessError, UnicodeError, ValueError):
        return None


def discover_plugin():
    herdr = shutil.which("herdr")
    if herdr is None:
        return None, "plugin_unavailable"
    completed = run_command(
        [herdr, "plugin", "list", "--plugin", PLUGIN_ID, "--json"]
    )
    if completed is None or completed.returncode != 0:
        return None, "plugin_unavailable"
    try:
        response = parse_json(completed.stdout)
    except (ValueError, TypeError, RecursionError):
        return None, "plugin_unavailable"
    if not isinstance(response, dict):
        return None, "plugin_unavailable"
    result = response.get("result")
    plugins = result.get("plugins") if isinstance(result, dict) else None
    if not isinstance(plugins, list):
        return None, "plugin_unavailable"
    matches = [
        plugin
        for plugin in plugins
        if isinstance(plugin, dict) and plugin.get("plugin_id") == PLUGIN_ID
    ]
    if len(matches) != 1:
        return None, "plugin_unavailable"
    plugin = matches[0]
    plugin_root = plugin.get("plugin_root")
    if plugin.get("enabled") is not True or not nonempty_string(plugin_root):
        return None, "plugin_unavailable"
    return plugin_root, None


def probe_capabilities(plugin_root, role):
    node = shutil.which("node")
    if node is None:
        return "capability_probe_failed"
    entrypoint = str(Path(plugin_root) / "src" / "bin" / "capture.ts")
    completed = run_command([node, entrypoint, "--capabilities"])
    if completed is None or completed.returncode != 0:
        return "capability_probe_failed"
    try:
        response = parse_json_line(completed.stdout)
    except (ValueError, TypeError, RecursionError):
        return "capability_invalid"
    if not isinstance(response, dict):
        return "capability_invalid"
    if response.get("protocol") != CAPTURE_PROTOCOL:
        return "protocol_mismatch"
    version = response.get("protocolVersion")
    if type(version) is not int or version != 1:
        return "protocol_version_mismatch"
    features = response.get("features")
    if not isinstance(features, list) or any(
        required not in features
        for required in ("orchestration-claim", "runtime-locator")
    ):
        return "feature_missing"
    roles = response.get("roles")
    if not isinstance(roles, list) or role not in roles:
        return "role_unsupported"
    return None


def doctor_result(role):
    plugin_root, reason = discover_plugin()
    if reason is None:
        reason = probe_capabilities(plugin_root, role)
    available = reason is None
    return {
        "ok": True,
        "available": available,
        "claim_supported": available,
        "reason": reason,
        "role": role,
    }


def parse_raw_path(text):
    """Return a single raw path line without its optional line terminator."""
    line = single_line_content(text)
    if line is None or not nonempty_string(line):
        return None
    return line


def read_runtime_locator():
    herdr = shutil.which("herdr")
    if herdr is None:
        return None
    completed = run_command([herdr, "plugin", "config-dir", PLUGIN_ID])
    if completed is None or completed.returncode != 0:
        return None
    config_dir = parse_raw_path(completed.stdout)
    if config_dir is None:
        return None
    try:
        raw = (Path(config_dir) / LOCATOR_FILENAME).read_text(encoding="utf-8")
        locator = parse_json(raw)
    except (OSError, UnicodeError, ValueError, TypeError, RecursionError):
        return None
    if not isinstance(locator, dict):
        return None
    if locator.get("protocol") != LOCATOR_PROTOCOL:
        return None
    version = locator.get("protocolVersion")
    if type(version) is not int or version != 1:
        return None
    if locator.get("pluginId") != PLUGIN_ID:
        return None
    state_dir = locator.get("stateDir")
    if (
        not nonempty_string(state_dir)
        or "\0" in state_dir
        or not Path(state_dir).is_absolute()
    ):
        return None
    socket_path = locator.get("socketPath")
    current_socket = os.environ.get("HERDR_SOCKET_PATH")
    if (
        not nonempty_string(socket_path)
        or not nonempty_string(current_socket)
        or socket_path != current_socket
    ):
        return None
    return state_dir


def unavailable_claim(reason):
    return {
        "ok": False,
        "claimed": False,
        "status": "unavailable",
        "claim_status": None,
        "reason": reason,
    }


def failed_claim(reason):
    return {
        "ok": False,
        "claimed": False,
        "status": "failed",
        "claim_status": None,
        "reason": reason,
    }


def normalize_capture(completed, requested_id):
    try:
        response = parse_json_line(completed.stdout)
    except (ValueError, TypeError, RecursionError):
        return failed_claim("invalid_capture_response")
    if not isinstance(response, dict):
        return failed_claim("invalid_capture_response")
    status = response.get("status")
    orchestration = response.get("orchestration")

    if status in ("captured", "duplicate"):
        if completed.returncode != 0 or not isinstance(orchestration, dict):
            return failed_claim("invalid_capture_response")
        if set(orchestration) != {"status", "id"}:
            return failed_claim("invalid_capture_response")
        claim_status = orchestration.get("status")
        if (
            claim_status not in ("claimed", "already_claimed")
            or orchestration.get("id") != requested_id
        ):
            return failed_claim("invalid_capture_response")
        return {
            "ok": True,
            "claimed": True,
            "status": status,
            "claim_status": claim_status,
            "reason": None,
        }

    if status == "skipped":
        if completed.returncode != 0 or orchestration is not None:
            return failed_claim("invalid_capture_response")
        return {
            "ok": False,
            "claimed": False,
            "status": "skipped",
            "claim_status": None,
            "reason": "capture_skipped",
        }

    if status == "failed":
        if completed.returncode != 1 or orchestration is not None:
            return failed_claim("invalid_capture_response")
        return failed_claim("capture_failed")

    if status == "conflict":
        if (
            completed.returncode != 3
            or orchestration is not None
            or response.get("requestedOrchestrationId") != requested_id
            or not nonempty_string(response.get("existingOrchestrationId"))
        ):
            return failed_claim("invalid_capture_response")
        return {
            "ok": False,
            "claimed": False,
            "status": "conflict",
            "claim_status": None,
            "reason": "claim_conflict",
        }

    return failed_claim("invalid_capture_response")


def claim_result(values):
    plugin_root, reason = discover_plugin()
    if reason is not None:
        return unavailable_claim(reason)
    reason = probe_capabilities(plugin_root, values["role"])
    if reason is not None:
        return unavailable_claim(reason)
    state_dir = read_runtime_locator()
    if state_dir is None:
        return unavailable_claim("runtime_locator_unavailable")

    node = shutil.which("node")
    if node is None:
        return unavailable_claim("capability_probe_failed")
    entrypoint = str(Path(plugin_root) / "src" / "bin" / "capture.ts")
    child_env = os.environ.copy()
    child_env.pop("HARVEST_STATE_DIR", None)
    child_env["HERDR_PLUGIN_STATE_DIR"] = state_dir
    command = [
        node,
        entrypoint,
        "--pane",
        values["pane"],
        "--orchestration-id",
        values["id"],
        "--orchestration-label",
        values["label"],
        "--orchestration-role",
        values["role"],
    ]
    completed = run_command(command, env=child_env)
    if completed is None:
        return failed_claim("capture_failed")
    return normalize_capture(completed, values["id"])


def report(result):
    emit_json(result)
    if result["reason"] is not None:
        print("harvestctl: " + result["reason"], file=sys.stderr)
    return 0


def main(argv):
    parsed = parse_args(argv)
    if parsed is None:
        return usage_error()
    action, values = parsed
    if action == "doctor":
        return report(doctor_result(values["role"]))
    return report(claim_result(values))


if __name__ == "__main__":
    sys.exit(main(sys.argv))
